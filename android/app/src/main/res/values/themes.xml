<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Splash Screen Theme -->
    <style name="Theme.DeadzoneSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0D12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/neon_radar</item>
        <item name="postSplashScreenTheme">@style/Theme.DeadzoneMessenger</item>
    </style>

    <!-- Main App Theme -->
    <style name="Theme.DeadzoneMessenger" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Base styling for window before Compose takes over -->
        <item name="android:statusBarColor">#0D0D12</item>
        <item name="android:windowBackground">#0D0D12</item>
        <item name="android:navigationBarColor">#0D0D12</item>
    </style>
</resources>
